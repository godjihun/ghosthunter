  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC8C\uC784\uC740 \uCD1D \uC740\uC2E0, \uC870\uC0AC, \uC0AC\uB0E5 \uC138
    \uB2E8\uACC4\uB85C \uC774\uB8E8\uC5B4\uC9D1\uB2C8\uB2E4.\n\uC740\uC2E0 \uB2E8\uACC4\uC5D0\uC11C\uB294
    \uADC0\uC2E0\uC774 \uC790\uC2E0\uC758 \uC601\uD63C\uC744 \uC0C8\uB85C\uC6B4 \uC704\uCE58\uC5D0
    \uC228\uAE41\uB2C8\uB2E4.\n\uC870\uC0AC \uB2E8\uACC4\uC5D0\uC11C\uB294 \uD1F4\uB9C8\uC0AC\uB4E4\uC774
    \uC870\uC0AC \uB3C4\uAD6C\uB97C \uC774\uC6A9\uD574 \uADC0\uC2E0\uC758 \uC601\uD63C\uC744
    \uCC3E\uC73C\uB7EC \uB2E4\uB2D9\uB2C8\uB2E4.\n\uC870\uC0AC \uB2E8\uACC4\uC758
    \uC81C\uD55C \uC2DC\uAC04\uC774 \uB05D\uB098\uAC70\uB098, \uADC0\uC2E0\uC774
    \uACF5\uACA9\uC744 \uC774\uC6A9\uD574  \uD1F4\uB9C8\uC0AC\uC758 \uC601\uD63C\uC744
    100%\uAE4C\uC9C0 \uD68C\uC218\uD558\uBA74\n\uC0AC\uB0E5 \uB2E8\uACC4\uC5D0 \uB3CC\uC785\uD569\uB2C8\uB2E4.
    \uC774\uB54C \uADC0\uC2E0\uC740 \uD1F4\uB9C8\uC0AC\uB97C \uC9C1\uC811\uC801\uC73C\uB85C
    \uC8FD\uC774\uB294 \uB2A5\uB825\uC744 \uC5BB\uAC8C \uB429\uB2C8\uB2E4."
